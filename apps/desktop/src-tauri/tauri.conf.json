{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vortex",
  "version": "0.2.1",
  "identifier": "io.vortex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vortex",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 460,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        },
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Vortex",
    "category": "Utility",
    "shortDescription": "Download manager",
    "longDescription": "Parallel transfers, real resume, and a queue that survives a restart.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "externalBin": [
      "binaries/vortexd",
      "binaries/vortex-host",
      "binaries/yt-dlp",
      "binaries/qjs",
      "binaries/ffmpeg"
    ]
  }
}
